{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPDS Project Manifest",
  "type": "object",
  "required": [
    "openpds"
  ],
  "properties": {
    "openpds": {
      "type": "object",
      "required": [
        "standard_version",
        "project_id",
        "title",
        "lifecycle_phase"
      ],
      "properties": {
        "standard_version": {
          "type": "string"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_phase": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
